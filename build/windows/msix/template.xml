<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="sing-share.exe"
        Arguments=""
        InstallLocation="C:\Program Files\sing-box\sing-share">
    </Installer>
    <PackageInformation
        PackageName="sing-share"
        PackageDisplayName="sing-share"
        PublisherName="CN=sing-box"
        PublisherDisplayName="sing-box"
        Version="0.1.0.0"
        PackageDescription="Share sing-box profiles over QRS">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="io.singbox.singshare"
                Description="Share sing-box profiles over QRS"
                DisplayName="sing-share"
                ExecutableName="sing-share.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>sing-share</DisplayName>
            <PublisherDisplayName>sing-box</PublisherDisplayName>
            <Description>Share sing-box profiles over QRS</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="sing-share.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
